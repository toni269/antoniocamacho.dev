{
  "name": "antoniocamacho.dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Static, fork-friendly personal portfolio foundation.",
  "engines": {
    "node": ">=24.22.0 <25",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "check:runtime": "node scripts/check-runtime.mjs",
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321 --ignore-lock",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "spellcheck": "cspell --no-progress",
    "check:types": "astro check && tsc --project tsconfig.tooling.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "lint:branch": "node scripts/check-branch.mjs",
    "lint:commits": "commitlint",
    "check:staged": "node scripts/check-staged.mjs",
    "check:push-commits": "node scripts/check-push-commits.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "quality": "npm run check:runtime && npm run lint:branch && npm run lint && npm run format:check && npm run spellcheck && npm run check:types && npm test",
    "quality:full": "npm run quality && npm run build && npm run test:e2e",
    "preinstall": "node scripts/check-runtime.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "astro": "7.4.0",
    "cspell": "10.4.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "lefthook": false
  }
}
