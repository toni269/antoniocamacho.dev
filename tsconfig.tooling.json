{
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "rootDir": "."
  },
  "include": ["scripts/**/*.mjs", "*.config.mjs"],
  "exclude": ["node_modules", "dist", "coverage"]
}
