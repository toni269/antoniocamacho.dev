{
  "version": "0.2",
  "language": "en",
  "files": [
    "src/**/*.{astro,ts,css}",
    "scripts/**/*.mjs",
    "tests/**/*.ts",
    "docs/**/*.md",
    "specs/**/*.md",
    "*.md",
    "*.json",
    "*.mjs",
    "*.ts",
    "*.toml",
    "*.yml",
    ".specify/memory/constitution.md"
  ],
  "dictionaryDefinitions": [
    {
      "name": "project",
      "path": "./cspell-project-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["project"],
  "ignorePaths": [
    "node_modules/**",
    "dist/**",
    ".astro/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    "package-lock.json",
    "cspell-project-words.txt"
  ],
  "useGitignore": true
}
